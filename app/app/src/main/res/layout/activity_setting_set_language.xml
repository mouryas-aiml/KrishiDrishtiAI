<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    tools:context=".SettingSetLanguage">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackSetLang"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu_send"
            android:rotation="180"
            app:tint="@color/colorWhite"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/sYL"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/select_language"
            android:textColor="@color/colorWhite"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <RadioGroup
            android:id="@+id/lang_grp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rodio_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:layout_marginBottom="8dp"
                android:text="@string/english"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rodio_k"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:layout_marginBottom="8dp"
                android:text="@string/kannada"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rodio_te"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:layout_marginBottom="8dp"
                android:text="@string/telugu"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rodio_ta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:layout_marginBottom="8dp"
                android:text="@string/tamil"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rodio_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:layout_marginBottom="8dp"
                android:text="@string/hindi"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rodio_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/colorWhite"
                android:text="@string/marathi"
                android:textSize="16sp" />

        </RadioGroup>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/colorWhite">

        <Button
            android:id="@+id/CancelBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:onClick="cancelClick"
            android:text="@string/cancel"
            android:textColor="@color/colorPrimary"
            android:backgroundTint="@color/colorEarthyLight"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/SaveBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:onClick="saveClick"
            android:text="@string/save"
            android:textColor="@color/colorWhite"
            android:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

</LinearLayout>
